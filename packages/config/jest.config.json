{
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.test\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "clearMocks": true
}
