# OCTAGON Club System — переменные окружения staging.
#
# Скопируйте в `.env.staging` в корне репозитория и заполните значения.
# Файл в git не попадает (см. .gitignore): секреты не хранятся в репозитории
# (docs/14-infrastructure.md).
#
# Секреты можно сгенерировать так:
#   openssl rand -base64 48

# --- база данных -----------------------------------------------------------
POSTGRES_USER=octagon
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ
POSTGRES_DB=octagon

# --- домены ----------------------------------------------------------------
# Публичные имена. Должны совпадать с DNS-записями и с сертификатами в
# infra/nginx/certs.
ADMIN_HOST=staging.example.com
API_HOST=api.staging.example.com

# --- API -------------------------------------------------------------------
NODE_ENV=production
API_PREFIX=api/v1
CLUB_TIMEZONE=Asia/Almaty

# Список источников для CORS. В staging обязателен: приложение не стартует без
# него, чтобы не повторить ошибку с открытым CORS.
CORS_ORIGINS=https://staging.example.com

# Секреты подписи токенов. Минимум 32 символа, значения должны отличаться от
# локальных и друг от друга.
JWT_ACCESS_SECRET=ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ
JWT_REFRESH_SECRET=ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Защита входа от перебора: 10 попыток в минуту с одного адреса.
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
INVITE_TTL_HOURS=72

LOG_LEVEL=info

# --- первый администратор --------------------------------------------------
# Создается сервисом `seed` один раз после миграций:
#   docker compose -f docker-compose.staging.yml run --rm seed
#
# Пароль минимум 12 символов. Демо-учетка из локального стенда на сервер не
# переносится: без этих переменных seed заполнит только справочники.
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ
SUPERADMIN_NAME=Владелец Клуба

# DATABASE_URL и REDIS_URL собираются в docker-compose.staging.yml из
# POSTGRES_*: так пароль не дублируется в двух местах и не расходится.
