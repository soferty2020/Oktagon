# Локальные store/cache держим внутри проекта: среда разработки может быть
# ограничена записью за пределами рабочей папки (см. docs/14-infrastructure.md).
store-dir=.tools/pnpm-store
cache-dir=.tools/pnpm-cache

# Классическая (npm-подобная) раскладка node_modules.
# Причина: изолированная раскладка pnpm не линкует транзитивные зависимости
# приложений так, как их ожидает рантайм (проявлялось как "Cannot find module
# 'tslib'/'uid'" из @nestjs/common при запуске собранного dist/main.js).
node-linker=hoisted

strict-peer-dependencies=false
engine-strict=false
link-workspace-packages=true
prefer-workspace-packages=true
