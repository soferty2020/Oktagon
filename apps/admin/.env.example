# Переменные окружения web-админки.
# Скопируйте в apps/admin/.env.local. Секретов здесь нет: токены пользователя
# живут в httpOnly-cookie, а не в конфигурации.

# Базовый URL backend API. Используется только серверной частью админки
# (route handlers проксируют запросы), в браузер не попадает.
API_BASE_URL=http://localhost:3000/api/v1
