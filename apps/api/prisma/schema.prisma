// OCTAGON Club System — Prisma schema.
//
// Источник истины по сущностям: docs/07-domain-model.md и docs/22-erd.md.
// Ограничения: docs/08-database.md.
// Бизнес-правила: docs/03-business-rules.md (BR-001..BR-012).
//
// Соглашения:
// - все первичные ключи — UUID;
// - timestamps хранятся в UTC (DateTime), календарные даты — @db.Date;
// - расчетный период хранится отдельными year/month, не выводится из timestamp;
// - бизнес-данные удаляются soft-delete/archive, а не физически.

generator client {
  provider = "prisma-client-js"
  // Явный output: клиент генерируется внутри приложения и не зависит от
  // postinstall-скрипта пакета @prisma/client (каталог .prisma в pnpm-сторе
  // создается именно им и теряется при установке с --ignore-scripts).
  //
  // Каталог лежит на уровень выше src: относительный путь одинаков и для
  // ts-node (src/prisma -> ../generated/prisma), и для собранного dist
  // (dist/prisma -> ../generated/prisma).
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (значения совпадают с packages/contracts/src/domain.ts)
// ---------------------------------------------------------------------------

/// docs/04-roles-permissions.md
enum UserRole {
  MEMBER
  STAFF
  SUPERADMIN
}

/// INVITED — аккаунт создан приглашением, пароль еще не задан.
enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
}

/// BR-006
enum AthleteStatus {
  ACTIVE
  FROZEN
  ARCHIVED
}

/**
 * Пояса клуба (K3, BR-015): фиксированный набор, порядок утверждён клубом.
 *
 * Порядок задан значениями контракта (`BELT_GRADES`), а не порядком в enum:
 * enum только ограничивает допустимые значения. CRUD через админку запрещён —
 * набор меняется только кодом.
 */
enum BeltGrade {
  WHITE
  ORANGE
  ORANGE_BLUE_STRIPE
  BLUE
  BLUE_YELLOW_STRIPE
  YELLOW
  YELLOW_GREEN_STRIPE
  GREEN
  GREEN_BROWN_STRIPE
  BROWN
  BROWN_GOLD_STRIPE
  BLACK
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum MembershipState {
  ACTIVE
  ENDED
}

/// BR-001..BR-004: помесячный учет оплаты.
enum MembershipPeriodStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  FULLY_PAID_MARKED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

/// ADR-0010: направление движения средств.
///
/// Возврат — не удаление поступления, а отдельная транзакция: деньги сначала
/// поступили, потом были возвращены, и оба факта остаются в истории (BR-007).
enum PaymentKind {
  PAYMENT
  REFUND
}

/// BR-009: точечное изменение экземпляра занятия.
enum TrainingSessionStatus {
  SCHEDULED
  CANCELLED
  MOVED
}

/// BR-008: итоговую посещаемость подтверждает тренер.
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// BR-012
enum ConversationType {
  GROUP
  DIRECT
}

enum ConversationMemberRole {
  MEMBER
  TRAINER
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String?    @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  middleName         String?    @map("middle_name")
  phone              String?
  role               UserRole   @default(MEMBER)
  status             UserStatus @default(INVITED)
  /// STAFF по умолчанию ограничен своими группами (docs/04-roles-permissions.md).
  scopeAllGroups     Boolean    @default(false) @map("scope_all_groups")
  lastLoginAt        DateTime?  @map("last_login_at")
  archivedAt         DateTime?  @map("archived_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  athleteLinks       UserAthlete[]
  trainerProfile     TrainerProfile?
  permissions        UserPermission[]
  refreshTokens      RefreshToken[]
  createdInvites     UserInvite[]       @relation("InviteCreatedBy")
  usedInvite         UserInvite?        @relation("InviteUsedBy")
  linkRequests       LinkRequest[]      @relation("LinkRequestUser")
  reviewedRequests   LinkRequest[]      @relation("LinkRequestReviewer")
  createdLinkCodes   AthleteLinkCode[]  @relation("LinkCodeCreatedBy")
  usedLinkCodes      AthleteLinkCode[]  @relation("LinkCodeUsedBy")
  attendanceMarked   Attendance[]       @relation("AttendanceMarkedBy")
  sessionsCancelled  TrainingSession[]  @relation("SessionCancelledBy")
  freezesCreated     FreezePeriod[]     @relation("FreezeCreatedBy")
  freezesClosed      FreezePeriod[]     @relation("FreezeClosedBy")
  paymentsCreated    PaymentTransaction[] @relation("PaymentCreatedBy")
  newsPosts          NewsPost[]
  newsComments       NewsComment[]
  conversationMember ConversationMember[]
  messages           Message[]
  auditLogs          AuditLog[]
  debtRulesCreated   DebtRule[]         @relation("DebtRuleCreatedBy")
  certificationsCreated Certification[]  @relation("CertificationCreatedBy")
  certificationEventsCreated CertificationEvent[] @relation("CertificationEventCreatedBy")
  certificationEventsPublished CertificationEvent[] @relation("CertificationEventPublishedBy")
  certificationRevisions CertificationResultRevision[]
  competitionsCreated Competition[] @relation("CompetitionCreatedBy")
  competitionsPublished Competition[] @relation("CompetitionPublishedBy")
  competitionRevisions CompetitionEntryRevision[]
  trialRequestsProcessed TrialRequest[] @relation("TrialRequestProcessedBy")

  @@index([role, status])
  @@index([archivedAt])
  @@map("users")
}

/// Индивидуальные permissions поверх роли (docs/04-roles-permissions.md).
model Permission {
  code        String           @id
  description String
  /// Финансовые permission (BR-010): доступ к payments/freezes.
  isFinancial Boolean          @default(false) @map("is_financial")
  createdAt   DateTime         @default(now()) @map("created_at")

  userPermissions UserPermission[]

  @@map("permissions")
}

model UserPermission {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  permissionId String     @map("permission_id")
  grantedById  String?    @map("granted_by_id") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at")
  expiresAt    DateTime?  @map("expires_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [code])

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

/// Приглашение пользователя администратором (MVP scope: без саморегистрации).
model UserInvite {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  role      UserRole  @default(MEMBER)
  /// Хранится только хеш токена приглашения.
  tokenHash String    @map("token_hash")
  /// Хеш короткого кода: тренер вводит его в приложении, ссылку открывать не нужно.
  codeHash  String?   @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdBy String    @map("created_by") @db.Uuid
  usedBy    String?   @unique @map("used_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  creator User  @relation("InviteCreatedBy", fields: [createdBy], references: [id])
  consumer User? @relation("InviteUsedBy", fields: [usedBy], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@map("user_invites")
}

/// Refresh token rotation (docs/15-security.md).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Athletes
// ---------------------------------------------------------------------------

model Athlete {
  id          String        @id @default(uuid()) @db.Uuid
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  middleName  String?       @map("middle_name")
  birthDate   DateTime?     @map("birth_date") @db.Date
  gender      Gender        @default(UNSPECIFIED)
  status      AthleteStatus @default(ACTIVE)
  /// Текущий пояс (K3). Белый — значение по умолчанию: пояс есть у каждого
  /// спортсмена с момента заведения карточки.
  beltGrade   BeltGrade     @default(WHITE) @map("belt_grade")
  /// Текущая ступень из RankCatalog (ADR-0012): `kyu-0`…`kyu-10`, `dan-1`…`dan-10`.
  ///
  /// Источник истины для пояса. Nullable намеренно: у записей, где пояс не
  /// выводится из аттестаций (например, синий пояс без единой аттестации),
  /// миграция не угадывает значение, а оставляет пусто до ручного разрешения.
  rank        String?       @map("rank") @db.VarChar(16)
  /// Дата присвоения пояса; у старых записей может отсутствовать.
  beltAwardedAt DateTime?   @map("belt_awarded_at") @db.Date
  phone       String?
  email       String?
  notes       String?
  /// Основной зал спортсмена (#66, ADR-0016): где он обычно занимается.
  /// Группа выбирается из групп этого зала; занятие может быть в другом зале.
  hallId      String?       @map("hall_id") @db.Uuid
  archivedAt  DateTime?     @map("archived_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  userLinks         UserAthlete[]
  hall              Hall?             @relation(fields: [hallId], references: [id])
  certifications    Certification[]
  certificationParticipants CertificationParticipant[]
  competitionParticipants CompetitionParticipant[]
  memberships       GroupMembership[]
  attendances       Attendance[]
  plannedAbsences   PlannedAbsence[]
  membershipPeriods MembershipPeriod[]
  payments          PaymentTransaction[]
  freezePeriods     FreezePeriod[]
  linkCodes         AthleteLinkCode[]
  linkRequests      LinkRequest[]

  @@index([status])
  @@index([lastName, firstName])
  @@map("athletes")
}

/// Аккаунт не равен карточке спортсмена: один аккаунт — несколько спортсменов.
model UserAthlete {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  athleteId  String   @map("athlete_id") @db.Uuid
  /// Например PARENT, GUARDIAN, SELF.
  relation   String   @default("PARENT")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([userId, athleteId])
  @@index([athleteId])
  @@map("user_athletes")
}

// ---------------------------------------------------------------------------
// Club structure
// ---------------------------------------------------------------------------



/// Зал — единственная площадка клуба (#64, ADR-0016).
///
/// Филиал упразднён: клуб делится по адресам, где проходят тренировки, а адрес —
/// свойство зала. Внутри зала — группы; занятие может проходить в другом зале.
model Hall {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  address    String?
  phone      String?
  capacity   Int?
  isActive   Boolean   @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  groups           Group[]
  athletes         Athlete[]
  trainingSessions TrainingSession[]

  @@index([name])
  @@map("halls")
}

model TrainerProfile {
  id          String    @id @default(uuid()) @db.Uuid
  /// Аккаунт тренера. Не обязателен: по docs/04-roles-permissions.md часть
  /// тренеров работает без входа в систему, и заводить им User не нужно.
  ///
  /// @unique здесь означает «у одного аккаунта не более одного профиля
  /// тренера». Несколько NULL допустимы: уникальный индекс Postgres считает
  /// NULL-значения различными, поэтому тренеров без аккаунта может быть много.
  userId      String?   @unique @map("user_id") @db.Uuid
  /// Имя и фамилия отдельно (#69): `displayName` собирается из них для списков.
  /// Nullable — у записей, созданных до разделения, поля заполняет миграция.
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  displayName String    @map("display_name")
  phone       String?
  bio         String?
  isActive    Boolean   @default(true) @map("is_active")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupTrainers    GroupTrainer[]
  trainingSessions TrainingSession[]
  certificationParticipants CertificationParticipant[]
  competitionParticipants CompetitionParticipant[]

  @@map("trainer_profiles")
}

// ---------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------

model Group {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  /// Зал, в котором занимается группа (#64, ADR-0016). Группа вне зала
  /// не существует: иерархия — зал → группы.
  hallId      String?   @map("hall_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  hall             Hall?             @relation(fields: [hallId], references: [id])
  trainers         GroupTrainer[]
  memberships      GroupMembership[]
  scheduleTemplates ScheduleTemplate[]
  trainingSessions TrainingSession[]
  conversations    Conversation[]

  @@index([hallId])
  @@map("groups")
}


model GroupTrainer {
  id               String    @id @default(uuid()) @db.Uuid
  groupId          String    @map("group_id") @db.Uuid
  trainerProfileId String    @map("trainer_profile_id") @db.Uuid
  isPrimary        Boolean   @default(false) @map("is_primary")
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  unassignedAt     DateTime? @map("unassigned_at")

  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id])

  @@index([trainerProfileId])
  @@map("group_trainers")
}

/// История членства. Одновременно допускается одна активная запись на спортсмена
/// (docs/08-database.md). Гарантируется частичным уникальным индексом в миграции.
model GroupMembership {
  id        String          @id @default(uuid()) @db.Uuid
  groupId   String          @map("group_id") @db.Uuid
  athleteId String          @map("athlete_id") @db.Uuid
  state     MembershipState @default(ACTIVE)
  joinedAt  DateTime        @default(now()) @map("joined_at") @db.Date
  leftAt    DateTime?       @map("left_at") @db.Date
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  group   Group   @relation(fields: [groupId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@index([groupId, state])
  @@index([athleteId, state])
  @@map("group_memberships")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

/// Квартальный регулярный шаблон расписания.
model ScheduleTemplate {
  id         String    @id @default(uuid()) @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  year       Int
  /// 1..4
  quarter    Int
  validFrom  DateTime  @map("valid_from") @db.Date
  validTo    DateTime  @map("valid_to") @db.Date
  publishedAt DateTime? @map("published_at")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  group    Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slots    ScheduleTemplateSlot[]
  sessions TrainingSession[]

  @@unique([groupId, year, quarter])
  @@index([validFrom, validTo])
  @@map("schedule_templates")
}

model ScheduleTemplateSlot {
  id                 String  @id @default(uuid()) @db.Uuid
  scheduleTemplateId String  @map("schedule_template_id") @db.Uuid
  weekday            Weekday
  startTime          DateTime @map("start_time") @db.Time(0)
  endTime            DateTime @map("end_time") @db.Time(0)
  hallId             String? @map("hall_id") @db.Uuid
  trainerProfileId   String? @map("trainer_profile_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  scheduleTemplate ScheduleTemplate @relation(fields: [scheduleTemplateId], references: [id], onDelete: Cascade)

  @@index([scheduleTemplateId, weekday])
  @@map("schedule_template_slots")
}

/// Материализованный экземпляр занятия. Точечное изменение экземпляра не меняет
/// шаблон (BR-009).
model TrainingSession {
  id                 String                @id @default(uuid()) @db.Uuid
  groupId            String                @map("group_id") @db.Uuid
  hallId             String?               @map("hall_id") @db.Uuid
  trainerProfileId   String?               @map("trainer_profile_id") @db.Uuid
  scheduleTemplateId String?               @map("schedule_template_id") @db.Uuid
  startsAt           DateTime              @map("starts_at")
  endsAt             DateTime              @map("ends_at")
  status             TrainingSessionStatus @default(SCHEDULED)
  /// Причина переноса/отмены; заполняется при точечном изменении.
  changeReason       String?               @map("change_reason")
  cancelledAt        DateTime?             @map("cancelled_at")
  cancelledById      String?               @map("cancelled_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  group            Group             @relation(fields: [groupId], references: [id])
  hall             Hall?             @relation(fields: [hallId], references: [id])
  trainerProfile   TrainerProfile?   @relation(fields: [trainerProfileId], references: [id])
  scheduleTemplate ScheduleTemplate? @relation(fields: [scheduleTemplateId], references: [id])
  cancelledBy      User?             @relation("SessionCancelledBy", fields: [cancelledById], references: [id])
  attendances      Attendance[]
  plannedAbsences  PlannedAbsence[]

  @@unique([groupId, startsAt])
  @@index([startsAt])
  @@index([trainerProfileId, startsAt])
  @@index([hallId, startsAt])
  @@map("training_sessions")
}

/// BR-008: предварительное сообщение родителя о планируемом отсутствии.
model PlannedAbsence {
  id                String   @id @default(uuid()) @db.Uuid
  trainingSessionId String   @map("training_session_id") @db.Uuid
  athleteId         String   @map("athlete_id") @db.Uuid
  reason            String?
  reportedById      String?  @map("reported_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  athlete         Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([trainingSessionId, athleteId])
  @@index([athleteId])
  @@map("planned_absences")
}

/// Итоговая посещаемость, подтвержденная тренером/администратором.
model Attendance {
  id                String           @id @default(uuid()) @db.Uuid
  trainingSessionId String           @map("training_session_id") @db.Uuid
  athleteId         String           @map("athlete_id") @db.Uuid
  status            AttendanceStatus
  comment           String?
  markedById        String?          @map("marked_by_id") @db.Uuid
  markedAt          DateTime         @default(now()) @map("marked_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  athlete         Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  markedBy        User?           @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([trainingSessionId, athleteId])
  @@index([athleteId])
  @@map("attendances")
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

/// Расчетный период: уникален по athlete + year + month (BR-001).
model MembershipPeriod {
  id            String                 @id @default(uuid()) @db.Uuid
  athleteId     String                 @map("athlete_id") @db.Uuid
  year          Int
  /// 1..12
  month         Int
  expectedAmount Decimal?              @map("expected_amount") @db.Decimal(12, 2)
  /// ADR-0010: зачтено = поступления − возвраты. Денормализация для выборок.
  paidAmount    Decimal                @default(0) @map("paid_amount") @db.Decimal(12, 2)
  /// ADR-0010: сколько всего возвращено по периоду. Нужно, чтобы «внесено 0 при
  /// возврате 25 000» не выглядело потерей данных.
  refundedAmount Decimal               @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  status        MembershipPeriodStatus @default(UNPAID)
  /// BR-003: ручная отметка «оплачен полностью».
  fullyPaidMarkedAt DateTime?          @map("fully_paid_marked_at")
  fullyPaidMarkedById String?          @map("fully_paid_marked_by_id") @db.Uuid
  note          String?
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  athlete    Athlete              @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  payments   PaymentTransaction[]

  @@unique([athleteId, year, month])
  @@index([year, month, status])
  @@map("membership_periods")
}

model PaymentTransaction {
  id                 String        @id @default(uuid()) @db.Uuid
  membershipPeriodId String        @map("membership_period_id") @db.Uuid
  athleteId          String        @map("athlete_id") @db.Uuid
  /// ADR-0010: PAYMENT — поступление, REFUND — возврат. Сумма всегда положительна.
  kind               PaymentKind   @default(PAYMENT)
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod @default(CASH)
  paidAt             DateTime      @map("paid_at") @db.Date
  comment            String?
  /// ADR-0010: поступление, к которому относится возврат. NULL — корректировка
  /// периода без привязки к конкретному поступлению.
  refundedPaymentId  String?       @map("refunded_payment_id") @db.Uuid
  createdById        String?       @map("created_by_id") @db.Uuid
  /// Ключ идемпотентности для мутаций оплаты (docs/23-api-contract-plan.md).
  idempotencyKey     String?       @unique @map("idempotency_key")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  membershipPeriod MembershipPeriod @relation(fields: [membershipPeriodId], references: [id], onDelete: Cascade)
  athlete          Athlete          @relation(fields: [athleteId], references: [id])
  createdBy        User?            @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  /// Поступление, к которому привязан возврат (ADR-0010).
  refundedPayment  PaymentTransaction?  @relation("PaymentRefund", fields: [refundedPaymentId], references: [id], onDelete: Restrict)
  refunds          PaymentTransaction[] @relation("PaymentRefund")

  @@index([athleteId, paidAt])
  @@index([refundedPaymentId])
  @@map("payment_transactions")
}

/// BR-005: заморозка — открытый период приостановления; начало и завершение
/// можно внести задним числом. Допускается один открытый период на спортсмена
/// (docs/08-database.md), гарантируется частичным уникальным индексом.
model FreezePeriod {
  id            String    @id @default(uuid()) @db.Uuid
  athleteId     String    @map("athlete_id") @db.Uuid
  startedOn     DateTime  @map("started_on") @db.Date
  endedOn       DateTime? @map("ended_on") @db.Date
  reason        String?
  createdById   String?   @map("created_by_id") @db.Uuid
  closedById    String?   @map("closed_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("FreezeCreatedBy", fields: [createdById], references: [id])
  closedBy  User?   @relation("FreezeClosedBy", fields: [closedById], references: [id])

  @@index([athleteId, startedOn])
  @@map("freeze_periods")
}

