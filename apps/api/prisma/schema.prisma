// ---------------------------------------------------------------------------
// Settings (docs/26-admin-settings.md)
// ---------------------------------------------------------------------------

/**
 * Правила расчета задолженности (K5, ADR-0014, BR-014).
 *
 * Версии, а не «текущие настройки»: задолженность считается за конкретный месяц,
 * и отчет за октябрь должен считаться по октябрьским правилам даже если в ноябре
 * их изменили. Действует версия с наибольшим `effectiveFrom`, не превышающим
 * расчетный месяц.
 *
 * Версия 1 создается миграцией и воспроизводит BR-004: дефолт — часть контракта,
 * а не «еще не настроено».
 */
model DebtRule {
  id String @id @default(uuid()) @db.Uuid

  /// Монотонный номер версии; уникален, чтобы историю нельзя было переписать.
  version Int @unique

  /// Первое число месяца, с которого действует версия. Уникально: одна версия
  /// на месяц, иначе было бы неясно, какая из них действует.
  effectiveFrom DateTime @unique @map("effective_from") @db.Date

  /// Учитывать ручную отметку «полностью оплачен» (BR-003).
  useFullyPaidMark Boolean @default(true) @map("use_fully_paid_mark")

  noTrainingPolicy DebtNoTrainingPolicy @default(EXEMPT) @map("no_training_policy")
  freezePolicy     DebtFreezePolicy     @default(EXEMPT_MONTH) @map("freeze_policy")
  expectedMissing  DebtExpectedMissing  @default(DEBTOR) @map("expected_missing")

  toleranceKind    DebtToleranceKind @default(NONE) @map("tolerance_kind")
  /// Допуск в тенге; null, если допуск не задан суммой.
  toleranceAmount  Decimal?          @map("tolerance_amount") @db.Decimal(12, 2)
  /// Допуск в процентах от ожидаемой суммы; null, если не задан процентом.
  tolerancePercent Decimal?          @map("tolerance_percent") @db.Decimal(5, 2)

  note        String?   @db.VarChar(500)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User? @relation("DebtRuleCreatedBy", fields: [createdById], references: [id])

  @@index([effectiveFrom])
  @@map("debt_rules")
}

/// Что делать, если в месяце не было ни одной тренировки группы.
enum DebtNoTrainingPolicy {
  /// Не считать должником (BR-004).
  EXEMPT
  DEBTOR
}

/// Освобождает ли заморозка от задолженности за месяц.
enum DebtFreezePolicy {
  /// Заморозка снимает долг за весь месяц (BR-004).
  EXEMPT_MONTH
  NONE
}

/// Как поступать с незаданной ожидаемой суммой.
enum DebtExpectedMissing {
  /// Считать должником: клуб еще не решил, сколько брать (BR-004).
  DEBTOR
  NOT_DEBTOR
}

/// Вид допустимой недоплаты.
enum DebtToleranceKind {
  NONE
  /// Абсолютная сумма в тенге.
  FIXED
  /// Процент от ожидаемой суммы.
  PERCENT
}

/// Вид ступени аттестации (карате: кю до чёрного пояса, дан — после).
enum CertificationStageKind {
  KYU
  DAN
}

/**
 * Аттестация спортсмена: когда, на какую ступень и какой пояс присвоен.
 *
 * Пояс хранится и в карточке спортсмена (`beltGrade`), но аттестация — это
 * событие с датой и ступенью, а карточка показывает только текущее состояние.
 * История без событий отвечала бы на «какой пояс сейчас», но не на «какая
 * ступень и когда получена».
 *
 * Создание аттестации обновляет текущий пояс спортсмена; отмена — пересчитывает
 * его по последней оставшейся аттестации.
 */
model Certification {
  id String @id @default(uuid()) @db.Uuid

  athleteId String @map("athlete_id") @db.Uuid
  /// Дата аттестации; будущие даты запрещены — это прошедшее событие.
  certifiedOn DateTime @map("certified_on") @db.Date

  beltGrade BeltGrade @map("belt_grade")
  stageKind CertificationStageKind @default(KYU) @map("stage_kind")
  /// Номер ступени: 1..10 для кю и для дана.
  stageNumber Int @map("stage_number")
  /// Присвоенная ступень из RankCatalog (ADR-0012). Для новых записей пишется
  /// вместе с поясом; у старых миграция заполняет по stageKind/stageNumber.
  rank String? @map("rank") @db.VarChar(16)

  note String? @db.VarChar(500)

  createdById String? @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CertificationCreatedBy", fields: [createdById], references: [id])
  /// Участник мероприятия, из которого создана аттестация (ADR-0012, #35).
  participant CertificationParticipant?

  @@index([athleteId, certifiedOn])
  @@map("certifications")
}

/**
 * Профиль клуба: единственная строка с фиксированным идентификатором.
 *
 * Секреты и параметры инфраструктуры здесь не хранятся: документ прямо запрещает
 * выносить их в админку. Часовой пояс — IANA-имя: по нему считаются даты занятий
 * и платежей, поэтому опечатка в нем испортила бы все расписание.
 */
model ClubProfile {
  id        String   @id @default("default") @db.VarChar(16)
  name      String   @db.VarChar(200)
  /// Ссылка на логотип. Загрузки файлов в MVP нет: хранится URL или ключ ассета.
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  phone     String?  @db.VarChar(32)
  email     String?  @db.VarChar(200)
  address   String?  @db.VarChar(500)
  /// IANA-имя часового пояса: по нему клуб считает даты занятий и платежей.
  timezone  String   @db.VarChar(64)
  /// День месяца, до которого нужно оплатить текущий месяц (1..28).
  ///
  /// NULL — срок не задан, просрочка не считается. Верхняя граница 28: иначе в
  /// феврале срок «30-е» не существовал бы.
  paymentDueDay Int? @map("payment_due_day")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("club_profile")
}

// ---------------------------------------------------------------------------
// Attestations: мероприятия, участники, версии результатов (#33–#35)
// ---------------------------------------------------------------------------

/// Статус мероприятия. Переходы описаны в contracts (`EVENT_TRANSITIONS`), а не
/// в БД: правило зависит от списка участников («завершить можно, когда у всех
/// есть итог»), и CHECK такого не выразит.
enum CertificationEventStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  PUBLISHED
  CANCELLED
}

/// Допуск к экзамену. Ставится вручную тренером или суперадмином.
enum ParticipantAdmission {
  PENDING
  ADMITTED
  REJECTED
}

/// Оплата экзамена: без суммы и без финансовой транзакции (BR-010 не нарушается).
enum ParticipantPaymentStatus {
  UNPAID
  PAID
}

/// Итог участника.
enum ParticipantResult {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

/// Экзаменационное мероприятие: дата, место, статус и список участников.
model CertificationEvent {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.VarChar(200)
  /// Дата и время экзамена.
  scheduledAt DateTime @map("scheduled_at")
  location    String? @db.VarChar(200)
  /// Организатор — свободный текст: не всякий экзамен проводит сотрудник клуба.
  organizer   String? @db.VarChar(200)
  description String? @db.VarChar(2000)

  status CertificationEventStatus @default(DRAFT)

  createdById String? @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  publishedAt   DateTime? @map("published_at")
  publishedById String?   @map("published_by_id") @db.Uuid
  cancelledAt   DateTime? @map("cancelled_at")

  createdBy   User? @relation("CertificationEventCreatedBy", fields: [createdById], references: [id])
  publishedBy User? @relation("CertificationEventPublishedBy", fields: [publishedById], references: [id])

  participants CertificationParticipant[]

  @@index([scheduledAt])
  @@index([status])
  @@map("certification_events")
}

/// Участник мероприятия.
///
/// Уникальность пары `eventId + athleteId` — на уровне БД: дубль участника
/// испортил бы и список, и подсчёт итогов.
model CertificationParticipant {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  athleteId String @map("athlete_id") @db.Uuid

  /// Ответственный за результат. Хранится отдельно от групп: при переводе
  /// спортсмена в другую группу право исправлять исторический результат остаётся
  /// у того, кто вёл экзамен.
  responsibleTrainerId String? @map("responsible_trainer_id") @db.Uuid

  /// Ступень, на которую сдаёт (из RankCatalog).
  targetRank String @map("target_rank") @db.VarChar(16)
  /// Снимок текущей ступени на момент добавления: нужен, чтобы посчитать переход
  /// через несколько ступеней и объяснить обоснование.
  snapshotRank String? @map("snapshot_rank") @db.VarChar(16)

  admission     ParticipantAdmission     @default(PENDING)
  paymentStatus ParticipantPaymentStatus @default(UNPAID) @map("payment_status")
  result        ParticipantResult        @default(PENDING)

  /// Присвоенная ступень при PASSED; может отличаться от targetRank при
  /// индивидуальном переходе через несколько ступеней.
  awardedRank   String? @map("awarded_rank") @db.VarChar(16)
  resultComment String? @map("result_comment") @db.VarChar(1000)

  /// Созданная запись Certification: одна на участника, без дублей при повторном
  /// сохранении результата.
  certificationId String? @unique @map("certification_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event              CertificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete            Athlete            @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  responsibleTrainer TrainerProfile?    @relation(fields: [responsibleTrainerId], references: [id])
  certification      Certification?     @relation(fields: [certificationId], references: [id])
  revisions          CertificationResultRevision[]

  @@unique([eventId, athleteId])
  @@index([athleteId])
  @@map("certification_participants")
}

/// Версия результата: исправление не затирает прежнее значение.
///
/// Задача #35 требует, чтобы исправление и отмена сохраняли историю с автором.
/// Отдельная таблица, а не поля аудита: версии нужны и в интерфейсе («что было
/// до исправления»), и при откате.
model CertificationResultRevision {
  id            String @id @default(uuid()) @db.Uuid
  participantId String @map("participant_id") @db.Uuid
  /// Номер версии внутри участника: 1, 2, 3…
  version       Int

  result      ParticipantResult
  awardedRank String? @map("awarded_rank") @db.VarChar(16)
  comment     String? @db.VarChar(1000)

  changedById String? @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at")
  /// Причина исправления: обязательна при изменении уже сохранённого итога.
  reason      String? @db.VarChar(500)

  participant CertificationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  changedBy   User?                    @relation(fields: [changedById], references: [id])

  @@unique([participantId, version])
  @@map("certification_result_revisions")
}
// ---------------------------------------------------------------------------
// Competitions: турниры, категории, участия и встречи (#36–#38)
// ---------------------------------------------------------------------------

enum CompetitionStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  PUBLISHED
  CANCELLED
}

enum CompetitionLevel {
  CLUB
  CITY
  REGIONAL
  NATIONAL
  INTERNATIONAL
}

enum CompetitionDiscipline {
  KUMITE
  KATA
}

/// Итог участия. PLACED требует места, NO_SHOW не может иметь медаль.
enum CompetitionEntryResult {
  PENDING
  PLACED
  PARTICIPATED
  ELIMINATED
  DISQUALIFIED
  NO_SHOW
}

enum CompetitionMedal {
  NONE
  GOLD
  SILVER
  BRONZE
}

/// Результат встречи в кумитэ.
enum CompetitionMatchResult {
  WIN
  LOSS
}

/// Турнир.
model Competition {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.VarChar(200)
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  location    String? @db.VarChar(200)
  organizer   String? @db.VarChar(200)
  level       CompetitionLevel @default(CLUB)
  description String? @db.VarChar(2000)
  status      CompetitionStatus @default(DRAFT)

  createdById String? @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")
  publishedById String? @map("published_by_id") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at")

  createdBy   User? @relation("CompetitionCreatedBy", fields: [createdById], references: [id])
  publishedBy User? @relation("CompetitionPublishedBy", fields: [publishedById], references: [id])

  participants CompetitionParticipant[]
  categories   CompetitionCategory[]

  @@index([startsAt])
  @@index([status])
  @@map("competitions")
}

/// Справочник категорий: общий (competitionId = null) или турнирный.
model CompetitionCategory {
  id          String @id @default(uuid()) @db.Uuid
  competitionId String? @map("competition_id") @db.Uuid

  discipline CompetitionDiscipline
  name       String @db.VarChar(200)
  ageFrom    Int?   @map("age_from")
  ageTo      Int?   @map("age_to")
  weightFrom Decimal? @map("weight_from") @db.Decimal(5, 1)
  weightTo   Decimal? @map("weight_to") @db.Decimal(5, 1)
  beltFrom   String? @map("belt_from") @db.VarChar(16)
  beltTo     String? @map("belt_to") @db.VarChar(16)
  isActive   Boolean @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  entries     CompetitionEntry[]

  @@index([discipline, isActive])
  @@map("competition_categories")
}

/// Спортсмен в турнире: одна оплата на весь турнир, не на дисциплину.
model CompetitionParticipant {
  id            String @id @default(uuid()) @db.Uuid
  competitionId String @map("competition_id") @db.Uuid
  athleteId     String @map("athlete_id") @db.Uuid
  responsibleTrainerId String? @map("responsible_trainer_id") @db.Uuid
  paymentStatus ParticipantPaymentStatus @default(UNPAID) @map("payment_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  athlete     Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  responsibleTrainer TrainerProfile? @relation(fields: [responsibleTrainerId], references: [id])
  entries     CompetitionEntry[]

  @@unique([competitionId, athleteId])
  @@index([athleteId])
  @@map("competition_participants")
}

/// Участие в дисциплине и категории: свой результат, своя история правок.
model CompetitionEntry {
  id            String @id @default(uuid()) @db.Uuid
  participantId String @map("participant_id") @db.Uuid
  categoryId    String @map("category_id") @db.Uuid
  discipline    CompetitionDiscipline

  categorySnapshot String @map("category_snapshot") @db.VarChar(200)

  result CompetitionEntryResult @default(PENDING)
  place  Int?
  medal  CompetitionMedal @default(NONE)
  comment String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participant CompetitionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  category    CompetitionCategory    @relation(fields: [categoryId], references: [id])
  matches     CompetitionMatch[]
  revisions   CompetitionEntryRevision[]

  @@unique([participantId, categoryId])
  @@map("competition_entries")
}

/// Встреча в кумитэ: соперник, стадия и результат. Отдельной базы соперников нет.
model CompetitionMatch {
  id           String @id @default(uuid()) @db.Uuid
  entryId      String @map("entry_id") @db.Uuid
  round        Int
  opponentName String @map("opponent_name") @db.VarChar(200)
  opponentClub String? @map("opponent_club") @db.VarChar(200)
  result       CompetitionMatchResult
  note         String? @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, round])
  @@map("competition_matches")
}
/// Версия результата участия (#38): исправление не затирает прежнее значение.
///
/// Появляется только после публикации турнира — до неё правка результата обычная
/// операция. Задача требует версионировать именно исправления опубликованного.
model CompetitionEntryRevision {
  id        String @id @default(uuid()) @db.Uuid
  entryId   String @map("entry_id") @db.Uuid
  version   Int
  result    CompetitionEntryResult
  place     Int?
  medal     CompetitionMedal
  comment   String? @db.VarChar(1000)
  changedById String? @map("changed_by_id") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at")
  reason    String? @db.VarChar(500)

  entry     CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  changedBy User?            @relation(fields: [changedById], references: [id])

  @@unique([entryId, version])
  @@map("competition_entry_revisions")
}
// ---------------------------------------------------------------------------
// Заявки на пробную тренировку (ADR-0013, #25)
// ---------------------------------------------------------------------------

enum TrialRequestStatus {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  CONVERTED
  REJECTED
}

/// Заявка с сайта или из соцсети.
///
/// Не спортсмен: до знакомства известны только имя и телефон. Карточку заводят
/// отдельно, когда человек пришёл.
model TrialRequest {
  id       String @id @default(uuid()) @db.Uuid
  name     String @db.VarChar(200)
  phone    String @db.VarChar(32)
  email    String? @db.VarChar(200)
  childName String? @map("child_name") @db.VarChar(200)
  /// Возраст ребёнка: дата рождения на этом шаге обычно неизвестна.
  childAge Int? @map("child_age")
  comment  String? @db.VarChar(2000)
  /// Откуда пришла: сайт, Instagram, звонок. Свободный текст — источников много.
  source   String? @db.VarChar(100)

  /// Согласие на обработку ПДн (#56, SEC-15): когда и какая редакция.
  /// Без него заявка не принимается — обрабатывать данные ребёнка нечем.
  consentAcceptedAt DateTime? @map("consent_accepted_at")
  consentVersion    String?   @map("consent_version") @db.VarChar(32)

  status TrialRequestStatus @default(NEW)

  processedAt   DateTime? @map("processed_at")
  processedById String?   @map("processed_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  processedBy User? @relation("TrialRequestProcessedBy", fields: [processedById], references: [id])

  @@index([status, createdAt])
  @@map("trial_requests")
}
// ---------------------------------------------------------------------------
// Онбординг родителей (#58, ADR-0015)
// ---------------------------------------------------------------------------

enum LinkRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Заявка родителя на привязку к ребёнку.
///
/// Создаётся, когда кода привязки нет: родитель вводит ФИО и дату рождения
/// ребёнка, администратор сопоставляет с карточкой и подтверждает. До
/// подтверждения родитель не видит ни одного спортсмена.
model LinkRequest {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  firstName    String            @map("first_name")
  lastName     String            @map("last_name")
  birthDate    DateTime?         @map("birth_date") @db.Date
  phone        String?
  status       LinkRequestStatus @default(PENDING)
  /// Заполняется при подтверждении: к какому спортсмену привязали.
  athleteId    String?           @map("athlete_id") @db.Uuid
  rejectReason String?           @map("reject_reason")
  reviewedBy   String?           @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?         @map("reviewed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user     User     @relation("LinkRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?    @relation("LinkRequestReviewer", fields: [reviewedBy], references: [id])
  athlete  Athlete? @relation(fields: [athleteId], references: [id])

  @@index([status])
  @@index([userId])
  @@map("link_requests")
}

/// Одноразовый код привязки родителя к спортсмену.
///
/// Выдаёт тренер группы или администратор. В базе только хеш: по дампу
/// действующий код не восстановить (тот же принцип, что у приглашений, ADR-0014).
model AthleteLinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  athleteId String    @map("athlete_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(64)
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  usedBy    String?   @map("used_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  creator User    @relation("LinkCodeCreatedBy", fields: [createdBy], references: [id])
  user    User?   @relation("LinkCodeUsedBy", fields: [usedBy], references: [id])

  @@index([athleteId])
  @@map("athlete_link_codes")
}