{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "db-e2e-spec.ts$"],
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@octagon/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
    "^@octagon/config$": "<rootDir>/../../packages/config/src/index.ts"
  },
  "testTimeout": 30000
}
