# OCTAGON Club System - backend API.
# Скопируйте в apps/api/.env и подставьте локальные значения.
# Секреты не коммитятся в git (docs/15-security.md).

NODE_ENV=local
PORT=3000
API_PREFIX=api/v1

# Локальная timezone клуба (docs/08-database.md)
CLUB_TIMEZONE=Asia/Almaty

# PostgreSQL
DATABASE_URL=postgresql://octagon:octagon@localhost:5432/octagon?schema=public

# Redis: rate limiting auth-эндпоинтов и кэш/очереди.
# Не задан — readiness не проверяет Redis.
REDIS_URL=redis://127.0.0.1:6379

# JWT: замените значения, минимум 32 символа
JWT_ACCESS_SECRET=change-me-local-access-secret-32-chars-min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=change-me-local-refresh-secret-32-chars-min
JWT_REFRESH_TTL_SECONDS=1209600

# Rate limiting для auth-эндпоинтов (docs/15-security.md)
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=10

# Время жизни приглашения пользователя
INVITE_TTL_HOURS=72

# Только для локальной разработки: разрешает заглушку аутентификации
# (заголовок x-user-id) на защищенных маршрутах. До реализации модуля auth.
# НИКОГДА не включайте в staging и production.
# LOCAL_AUTH_STUB=true

LOG_LEVEL=info
