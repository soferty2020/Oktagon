{
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@octagon/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
    "^@octagon/config$": "<rootDir>/../../packages/config/src/index.ts"
  },
  "collectCoverageFrom": ["src/**/*.ts"],
  "coverageDirectory": "./coverage",
  "coveragePathIgnorePatterns": ["\\.module\\.ts$", "\\.spec\\.ts$"],
  "clearMocks": true
}
